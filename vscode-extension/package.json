{
  "name": "omnicore-markdown-viewer",
  "displayName": "Omnicore Markdown Viewer",
  "description": "Rich markdown preview with Mermaid diagrams, OmniWare wireframes, interactive tables (Tabulator.js), and PrismJS syntax highlighting",
  "version": "1.3.0",
  "publisher": "omnicore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmniCoreST/omnicore-markdown-viewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": ["markdown", "mermaid", "preview", "omniware", "tabulator"],
  "icon": "media/icons/logo.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mermaid",
    "onCommand:omnicore.openPreview",
    "onCommand:omnicore.openPreviewToSide"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "omnicore.markdownEditor",
        "displayName": "Omnicore Markdown Viewer",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.mmd" },
          { "filenamePattern": "*.mermaid" },
          { "filenamePattern": "*.ow" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "omnicore.openInDesktopApp",
        "title": "Open in Omnicore Desktop App",
        "category": "Omnicore",
        "icon": "$(link-external)"
      },
      {
        "command": "omnicore.openAsText",
        "title": "Omnicore: Open as Text",
        "icon": "$(go-to-file)"
      },
      {
        "command": "omnicore.openPreview",
        "title": "Omnicore: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "omnicore.openPreviewToSide",
        "title": "Omnicore: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "omnicore.exportPdf",
        "title": "Omnicore: Export to PDF"
      },
      {
        "command": "omnicore.exportWord",
        "title": "Omnicore: Export to Word"
      },
      {
        "command": "omnicore.toggleBold",
        "title": "Omnicore: Toggle Bold"
      },
      {
        "command": "omnicore.toggleItalic",
        "title": "Omnicore: Toggle Italic"
      },
      {
        "command": "omnicore.toggleCode",
        "title": "Omnicore: Toggle Code"
      },
      {
        "command": "omnicore.toggleList",
        "title": "Omnicore: Toggle List"
      },
      {
        "command": "omnicore.removeFormatting",
        "title": "Omnicore: Remove Formatting"
      },
      {
        "command": "omnicore.recentFiles.clear",
        "title": "Clear All",
        "icon": "$(clear-all)"
      },
      {
        "command": "omnicore.recentFiles.remove",
        "title": "Remove from Recent",
        "icon": "$(close)"
      },
      {
        "command": "omnicore.recentFiles.openContainingFolder",
        "title": "Open Containing Folder"
      },
      {
        "command": "omnicore.recentFiles.copyPath",
        "title": "Copy Path"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mkdn|mmd|mermaid|ow)$/i",
          "command": "omnicore.openInDesktopApp",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mkdn|mmd|mermaid|ow)$/i",
          "command": "omnicore.openInDesktopApp",
          "group": "1_open@90"
        }
      ],
      "commandPalette": [
        {
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mkdn|mmd|mermaid|ow)$/i",
          "command": "omnicore.openInDesktopApp"
        }
      ],
      "editor/title": [
        {
          "when": "activeCustomEditorId == omnicore.markdownEditor",
          "command": "omnicore.openInDesktopApp",
          "group": "1_omnicore@1"
        },
        {
          "when": "activeCustomEditorId == omnicore.markdownEditor",
          "command": "omnicore.openAsText",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == markdown || resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .ow",
          "command": "omnicore.openPreviewToSide",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "omnicore.recentFiles.clear",
          "when": "view == omnicoreRecentFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "omnicore.recentFiles.remove",
          "when": "view == omnicoreRecentFiles",
          "group": "inline"
        },
        {
          "command": "omnicore.recentFiles.openContainingFolder",
          "when": "view == omnicoreRecentFiles"
        },
        {
          "command": "omnicore.recentFiles.copyPath",
          "when": "view == omnicoreRecentFiles"
        }
      ]
    },
    "keybindings": [
      {
        "command": "omnicore.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == markdown || resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .ow"
      },
      {
        "command": "omnicore.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == markdown || resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .ow"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnicoreExplorer",
          "title": "Omnicore",
          "icon": "media/icons/logo.png"
        }
      ]
    },
    "views": {
      "omnicoreExplorer": [
        {
          "id": "omnicoreRecentFiles",
          "name": "Recent Files"
        }
      ]
    },
    "configuration": {
      "title": "Omnicore Markdown Viewer",
      "properties": {
        "omnicore.desktopApp.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the Omnicore Markdown Viewer desktop app used by **Open in Omnicore Desktop App**. Empty: found automatically (`omnicore-markdown-viewer` on `PATH`, `/opt/Omnicore Markdown Viewer`, Program Files, `/Applications`)."
        },
        "omnicore.pdf.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Chrome, Chromium, Edge or Brave executable used for **Export to PDF** (printed headless). Empty: `CHROME_PATH`, then `google-chrome`, `chromium`, `microsoft-edge`, `brave-browser` … on `PATH`, then the usual install folders."
        }
      }
    },
    "languages": [
      {
        "id": "mermaid",
        "extensions": [".mmd", ".mermaid"],
        "aliases": ["Mermaid Diagram"]
      },
      {
        "id": "omniware",
        "extensions": [".ow"],
        "aliases": ["OmniWare Wireframe"]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package",
    "gen:emoji": "node scripts/gen-emoji-map.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "html-to-docx": "^1.8.0"
  }
}
